# Wesh Star IA example environment — replace placeholders; never commit real secrets.
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@localhost:5432/wesh_star
DATABASE_SSL=false
DATABASE_POOL_MAX=10
SESSION_SECRET=replace-with-a-long-random-secret
COMMUNICATIONS_ENABLED=false
CRON_SECRET=replace-with-a-long-random-secret
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
WESH_PAYMENT_CURRENCY=EUR
WESH_APP_URL=http://localhost:3000
WESH_STORAGE_ROOT=./storage
WESH_STORAGE_SIGNING_SECRET=replace-with-a-long-random-secret
ENABLE_FFMPEG=false
FFMPEG_BIN=ffmpeg
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Creator withdrawal minimum; clamped by the app to EUR 10–15 (default 10).
WESH_CREATOR_PAYOUT_MIN_EUR=10
# ISO country codes allowed for creator monetization, comma-separated; configure only after reviewing eligibility.
WESH_MONETIZATION_COUNTRIES=
# Comma-separated ISO country codes allowed for creator rewards (e.g. DE,FR); leave empty until reviewed.

# ---------- V29 : variables complétées (toutes celles lues par le code) ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTOPILOT_USER_ID=

# Moteur vidéo / voix auto-hébergés (le même jeton doit être donné au GPU worker : WESH_GPU_WORKER_TOKEN).
WESH_GPU_WORKER_TOKEN=replace-with-a-long-random-secret
SELF_HOSTED_VIDEO_URL=http://gpu-worker:8000
SELF_HOSTED_TTS_URL=http://local-tts:8001
SELF_HOSTED_PUBLIC_BASE_URL=
SELF_HOSTED_WORKER_INDEX=0
SELF_HOSTED_WIDTH=1280
SELF_HOSTED_HEIGHT=720
SELF_HOSTED_FPS=24
SELF_HOSTED_CLIP_SECONDS=10
SELF_HOSTED_REQUEST_TIMEOUT_MS=600000

# E-mail (mot de passe oublié, notifications).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Wesh Star IA <no-reply@example.com>"

# Paiements : PayPal.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Paiements : Flutterwave (Mobile Money, FCFA). Le « Secret hash » du webhook doit être identique à FLUTTERWAVE_SECRET_HASH
# (16 caractères minimum). URL du webhook à saisir chez Flutterwave : https://TON-SITE/api/payments/flutterwave/webhook
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=replace-with-a-long-random-secret

# Paiement direct (virement / Mobile Money manuel) et trésorerie FCFA.
WESH_PAYMENT_METHOD_NAME=Wesh Star IA Direct
WESH_PAYMENT_ACCOUNT_NAME=Wesh Star IA
WESH_PAYMENT_IBAN=
WESH_PAYMENT_BIC=
WESH_PAYMENT_INSTRUCTIONS=
WESH_MOBILE_MONEY_NAME=
WESH_MOBILE_MONEY_MTN=
WESH_MOBILE_MONEY_MOOV=
WESH_XOF_PER_EUR=655.957
WESH_PAYOUT_PROVIDER=manual
WESH_SUBSCRIPTION_DAYS=30

# Réseaux sociaux (autopilot) — à remplir seulement pour ceux que tu actives.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_USER_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_OWNER_URN=
LINKEDIN_VERSION=202501
SNAPCHAT_UPLOAD_ENDPOINT=
TWITCH_STREAM_KEY=

# ---------- LiveKit (LIVE audio/vidéo auto-hébergé) ----------
LIVEKIT_API_KEY=replace_with_random_key
LIVEKIT_API_SECRET=replace_with_long_random_secret
LIVEKIT_PUBLIC_URL=wss://live.example.com

# ---------- LiveKit (LIVE audio/vidéo auto-hébergé) ----------
LIVEKIT_API_KEY=replace_with_random_key
LIVEKIT_API_SECRET=replace_with_long_random_secret
LIVEKIT_PUBLIC_URL=wss://live.example.com
